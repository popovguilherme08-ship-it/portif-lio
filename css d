/*----------------VARIÁVEIS GLOBAIS-----------------*/
:root {
    /*Configuração da Fonte*/
    --fonte-texto: "Tahoma";
    --fonte-titulo: "Space Grotesk";
    --fonte-mono: "JetBrains Mono";

    /*Cores*/
    --cor-texto-variacao: #496949;
    --cor-borda: #be7b7b;
    --cor-fundo: #6e0101;
    --cor-titulo-tag: #507c63;
    --cor-texto-suave: #868fa1;
    --cor-clara: #afc7b9;
}
/*--------------------------------*/

*{
    margin: 0;
    padding: 0;
}
body {
    font-family: var(--fonte-texto);
}

/*Limpa a configuração padrão dos links feitas pelo navegador*/
a {
    text-decoration: none;
    color: inherit;
}

/*Estilização padrão dos títulos tipo "tag HTML" de cada seção*/
.tag-secao{
    display:inline-block;
    font-family: var(--fonte-mono);
    font-size:14px;
    color: var(--cor-titulo-tag);
    background-color: rgba(82, 110, 107, 0.1);
    border-radius: 6px; /*Bordas arredondadas*/
    margin-bottom: 16px; /*Margem inferior*/
    padding: 4px 12px;  /*Espaçamento topo e direita*/
}

/*Estilização de BOTÕES: dois estilos*/
.botao{
    display: inline-block;
    font-family: var(--fonte-texto);
    font-size: 16px;
    font-weight: 600; /*Negrito*/
    padding: 12px 28px; /*Espaçamento no topo e na direita*/
    border-radius: 999px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.botao:hover{
    transform: translatey(-4px); /*Efeito que move o botão para cima quando passa o mouse*/
}
.botao-primario{
    background-color: var(--cor-texto-variacao);
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(15,157,139,0.35);
}
./* Botão com preenchimento da esquerda para a direita */
.botao-deslizante {
  position: relative;
  overflow: hidden;
  z-index: 1;
}

.botao-deslizante::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background-color: var(--cor-clara); /* Cor que vai preencher no hover */
  transition: left 0.3s ease;
  z-index: -1;
}

.botao-deslizante:hover::before {
  left: 0;
}

.botao-deslizante:hover {
  color: var(--cor-texto-variacao); /* Cor do texto quando o fundo preencher */
}

.botao-secundario{
    border: 2px solid var(--cor-clara); /*Borda do botão*/
}
.botao-secundario:hover{ /*Botao Layout 2 quando o mouse passa em cima*/
    border-color: var(--cor-texto-variacao); /*Cor da borda do botão*/
    color: var(--cor-texto-variacao); /*Cor da fonte*/
}

/*--------------CABEÇALHO-----------------*/
.nome{
    font-size: 28px; /*Define o tamanho da fonte*/
    font-weight: bold; /*Fonte em negrito*/
}
.nome span{
    color: var(--cor-texto-variacao); /*Define cor do texto*/
}
.cabecalho{
    background-color: rgba(245,247,250,0.85); /*Define a cor de fundo com o 0.85 aplicando uma pequena transparência*/
    backdrop-filter: blur(8px); /*Aplica o efeito blur ao passar o conteúdo por trás*/
    position: sticky; /*Define a posição "parada" para o cabeçalho, sem rolagem*/
    z-index: 100; /*Trás o cabeçalho pra frente pro conteúdo passar atrás*/
    top: 0; /*Define que o cabeçalho ficará parado no topo*/
    border-bottom: 1px solid var(--cor-borda); /*Cria uma borda inferior no cabeçalho*/
}
.cabecalho .container{
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100px;
}
.menu {/*Estilização geral do menu*/
    display: flex;
    gap: 32px;
}

.menu a{ /*Estilização específica dos links do menu*/
    font-size: 24px;
    position: relative;
    padding-bottom: 4px;
}
.menu a::after{ /*Efeito do sublinhado animado*/
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0%;
    height: 2px;
    background-color: var(--cor-texto-variacao);
    transition: width 0.25s ease;
}
.menu a:hover::after{ /*Efeito do sublinhado animado*/
    width: 100%;
}
/*-------------------------------*/

/*--------------APRESENTAÇÃO--------------*/
.apresentacao{
    padding: 96px;
    background-color: var(--cor-fundo);
}
.apresentacao .container{
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
}
.apresentacao-titulo{
    font-family: var(--fonte-titulo);
    font-size: 40px;
    margin-bottom: 16px;
}
.apresentacao-titulo .destaque{
    color:var(--cor-texto-variacao);
}
.apresentacao-cargo{
    font-family: var(--fonte-mono);
    color: var(--cor-texto-suave);
    font-size: 18px;
    margin-bottom: 20px;
}
.apresentacao-bio{
    color: var(--cor-texto-suave);
    font-size: 16px;
    max-width: 480px; /*Tamanho máximo do elemento*/
    margin-bottom: 32px; /*Margem inferior*/
    line-height: 1.5; /*Espaçamento entre linhas*/
}
.apresentacao-foto{
    position: relative;
}
.apresentacao-foto img{
    border-radius: 24px; /*Bordas arredondadas*/
    background-color: rgba(245,247,250,0.85);
}
.apresentacao-botoes{
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}
/* --------------------------------------------------------------------------
   FORMAÇÃO ACADÊMICA 
   -------------------------------------------------------------------------- */
.formacao {
  padding: 96px 0; /*Espaço interno acima da seção*/
  background-color: var(--cor-fundo);
}

.linha-tempo {
  padding-left: 22px; /*Espaço padrão de uma lista, só o suficiente pro marcador aparecer*/
}

.item-tempo {
  margin-bottom: 28px; /*Espaço entre um item da formação e o próximo*/
}

.item-tempo::marker {
  color: var(--cor-primaria); /*Pinta o marcador que a lista já desenha sozinha, na cor de destaque do site*/
  font-size: 28px; /*Deixa o marcador um pouco maior, sem precisar mexer no tamanho do texto*/
}

.periodo {
  font-family: var(--fonte-mono); /*Fonte monoespaçada, reforçando a estética de código*/
  font-size: 13px; /*Tamanho do texto do período*/
  color: var(--cor-primaria); /*Cor de destaque, chamando atenção pra data*/
  margin-bottom: 4px; /*Espaço abaixo da data*/
}
/* --------------------------------------------------------------------------
   CURSOS
   Grid responsivo: o navegador decide sozinho quantas colunas cabem,
   com auto-fit + minmax. Chamado de grid "inteligente".
   -------------------------------------------------------------------------- */
.cursos {
  padding: 96px 0; /*Espaço interno acima da seção*/
  background-color: var(--cor-fundo-alt); /*Fundo branco, mesma lógica usada em "sobre"*/
}

.cursos-grid {
  display: grid; /*Organiza os cursos em grade*/
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); /*Cria quantas colunas de ~240px couberem na tela*/
  gap: 24px; /*Espaço entre os cartões*/
}

.curso-card {
  background-color: var(--cor-fundo); /*Fundo salmão do cartão, contrastando com o branco da seção*/
  border-radius: 16px; /*Arredonda os cantos do cartão*/
  padding: 28px; /*Espaçamento interno do cartão*/
  transition: transform 0.2s ease, box-shadow 0.2s ease; /*Anima suavemente a posição e a sombra no hover*/
}

.curso-card:hover {
  transform: translateY(-4px); /*Sobe o cartão 4px ao passar o mouse*/
  box-shadow: 0 8px 24px #10182814; /*Adiciona sombra só no hover, dando sensação de profundidade*/
}

.curso-icone {
  font-size: 18px; /*Tamanho do emoji/ícone do curso*/
  margin-bottom: 16px; /*Espaço abaixo do ícone*/
}

.curso-card h3 {
  font-size: 16px; /*Tamanho do nome do curso*/
  margin-bottom: 6px; /*Espaço abaixo do título*/
}

.curso-card p {
  color: var(--cor-texto-suave); /*Cor suave para a descrição do curso*/
  font-size: 14px; /*Tamanho do texto da descrição*/
  margin-bottom: 16px; /*Espaço abaixo da descrição*/
}

.curso-carga {
  font-family: var(--fonte-mono); /*Fonte monoespaçada, reforçando a estética de código*/
  font-size: 14px; /*Tamanho do texto da carga horária*/
  color: var(--cor-primaria); /*Cor de destaque*/
  background-color: rgba(15, 157, 139, 0.1); /*Fundo claro atrás do texto*/
  padding: 4px 10px; /*Espaçamento interno, formato de pílula*/
  border-radius: 6px; /*Arredonda os cantos da etiqueta*/
}
/* --------------------------------------------------------------------------
  PROJETOS
  Cada projeto é um cartão com imagem, texto e "tags" de tecnologia.
-------------------------------------------------------------------------- */
.projetos {
  padding: 96px 0; /*Espaço interno acima e abaixo da seção*/
}

.projetos-grid {
  display: grid; /*Organiza os projetos em grade*/
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); /*Cria quantas colunas de ~300px couberem na tela, sozinho*/
  gap: 32px; /*Espaço entre os cartões*/
}

.projeto-card {
  background-color: var(--cor-fundo-alt); /*Fundo branco do cartão*/
  border-radius: 16px; /*Arredonda os cantos do cartão*/
  overflow: hidden; /*Esconde qualquer parte da imagem que ultrapasse os cantos arredondados*/
  box-shadow: var(--sombra-card); /*Sombra padrão do site, dando profundidade ao cartão*/
  transition: transform 0.2s ease; /*Anima suavemente a posição no hover*/
}

.projeto-card:hover {
  transform: translateY(-6px); /*Sobe o cartão 6px ao passar o mouse*/
}

.projeto-imagem {
  aspect-ratio: 3 / 2; /*Mantém a proporção 3:2, não importa o tamanho da imagem original*/
  overflow: hidden; /*Corta qualquer parte da imagem que ultrapasse essa proporção*/
}

.projeto-imagem img {
  width: 100%; /*Imagem preenche toda a largura do espaço reservado*/
  height: 100%; /*Imagem preenche toda a altura do espaço reservado*/
  object-fit: cover; /*Corta a imagem para preencher o espaço, sem distorcer nem esticar*/
}

.projeto-corpo {
  padding: 24px; /*Espaçamento interno da parte de texto do cartão*/
}

.projeto-corpo h3 {
  font-size: 18px; /*Tamanho do título do projeto*/
  margin-bottom: 8px; /*Espaço abaixo do título*/
}

.projeto-corpo p {
  color: var(--cor-texto-suave); /*Cor suave para a descrição*/
  font-size: 14px; /*Tamanho do texto da descrição*/
  margin-bottom: 16px; /*Espaço abaixo da descrição*/
}

.projeto-tags {
  display: flex; /*Alinha as etiquetas de tecnologia lado a lado*/
  flex-wrap: wrap; /*Quebra para a próxima linha se não couberem todas*/
  gap: 8px; /*Espaço entre as etiquetas*/
  margin-bottom: 20px; /*Espaço abaixo do grupo de etiquetas*/
}

.projeto-tags span {
  font-family: var(--fonte-mono); /*Fonte monoespaçada, reforçando a estética de código*/
  font-size: 14px; /*Tamanho do texto de cada etiqueta*/
  background-color: var(--cor-fundo); /*Fundo da etiqueta*/
  border: 1px solid var(--cor-borda); /*Contorno sutil*/
  padding: 4px 10px; /*Espaçamento interno, formato de pílula*/
  border-radius: 6px; /*Arredonda os cantos da etiqueta*/
}

.projeto-links {
  display: flex; /*Alinha os links lado a lado*/
  gap: 20px; /*Espaço entre os links*/
  font-size: 14px; /*Tamanho do texto dos links*/
  font-weight: 600; /*Deixa os links em negrito*/
}

.projeto-links a {
  color: var(--cor-primaria); /*Cor de destaque*/
}

.projeto-links a:hover {
  text-decoration: underline; /*Sublinha o link ao passar o mouse*/
}

/* --------------------------------------------------------------------------
   CONTATO / RODAPÉ
   Seção escura para fechar o site com contraste em relação ao resto
   da página, reforçando que é a "última parada".
-------------------------------------------------------------------------- */
.contato {
  padding: 96px 0 48px; /*Três valores: espaço em cima, nos lados (0) e embaixo — menor embaixo por ser a última seção da página*/
  background-color: var(--cor-texto); /*Fundo escuro, destacando esta seção como o fechamento do site*/
  color: #ffffff; /*Texto branco, para contrastar com o fundo escuro*/
  text-align: center; /*Centraliza todo o conteúdo da seção*/
}

.contato .tag-secao {
  background-color: rgba(255, 255, 255, 0.1); /*Sobrescreve o fundo padrão da etiqueta por um tom claro e translúcido, adequado ao fundo escuro*/
}

.contato .titulo-secao {
  color: #ffffff; /*Sobrescreve a cor do título para branco, já que o padrão é escuro*/
}

.contato .subtitulo-secao {
  color: rgba(255, 255, 255, 0.6); /*Branco com transparência, criando um texto mais suave que o título*/
  margin: 0 auto 40px; /*Centraliza o bloco e adiciona espaço abaixo dele*/
}

.contato-botoes {
  display: flex; /*Alinha os botões lado a lado*/
  justify-content: center; /*Centraliza os botões horizontalmente*/
  gap: 16px; /*Espaço entre os botões*/
  margin-bottom: 64px; /*Espaço abaixo do grupo de botões*/
  flex-wrap: wrap; /*Quebra para a próxima linha em telas menores*/
}

.redes-sociais {
  display: flex; /*Alinha os ícones/links de redes sociais lado a lado*/
  justify-content: center; /*Centraliza o grupo horizontalmente*/
  gap: 24px; /*Espaço entre os links*/
  margin-bottom: 40px; /*Espaço abaixo do grupo*/
}

.redes-sociais a {
  font-family: var(--fonte-mono); /*Fonte monoespaçada, reforçando a estética de código*/
  font-size: 0.9rem; /*Tamanho do texto de cada link*/
  color: rgba(255, 255, 255, 0.7); /*Branco quase opaco, legível mas suave*/
  border: 1px solid rgba(255, 255, 255, 0.2); /*Contorno sutil e translúcido*/
  padding: 8px 16px; /*Espaçamento interno, formato de pílula*/
  border-radius: 999px; /*Cantos totalmente arredondados, mesmo truque dos botões*/
  transition: border-color 0.2s ease, color 0.2s ease; /*Anima suavemente a cor e o contorno no hover*/
}

.redes-sociais a:hover {
  border-color: var(--cor-primaria); /*Contorno destaca na cor de destaque do site ao passar o mouse*/
  color: var(--cor-primaria); /*Texto acompanha a mesma cor*/
}

.rodape-texto {
  font-size: 0.8rem; /*Tamanho pequeno, discreto*/
  color: rgba(255, 255, 255, 0.4); /*Branco bem apagado, o elemento de menor destaque da seção*/
  font-family: var(--fonte-mono); /*Fonte monoespaçada, reforçando a estética de código*/
}
